{
  "name": "desk-assistant",
  "productName": "Desk Assistant",
  "version": "0.1.0",
  "description": "Écoute l'audio du bureau Windows, transcrit (ElevenLabs Scribe) et répond via Claude dans une petite fenêtre discrète.",
  "author": "Cronix2",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
