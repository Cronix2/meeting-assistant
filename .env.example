# Facultatif : repli si aucune clé n'est enregistrée dans les Réglages.
# (Les clés saisies dans l'appli sont chiffrées via DPAPI/safeStorage et ont priorité.)
# Sous Windows PowerShell : $env:ELEVENLABS_API_KEY="..." ; $env:ANTHROPIC_API_KEY="..." ; npm run dev
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
